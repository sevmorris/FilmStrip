# Pinned FFmpeg binaries for FilmStrip (arm64 macOS).
# Audio-only LGPL build produced by scripts/build-ffmpeg.sh — no --enable-gpl,
# no --enable-nonfree, no --enable-version3; libmp3lame is the only external library.
# Update checksums and FFMPEG_DEPS_TAG when rebasing to a new build.
#
# REPRODUCIBLE: `./scripts/build-ffmpeg.sh <dir>` on the same toolchain rebuilds
# these byte for byte, so the checksums below are independently verifiable rather
# than merely asserted.
#
# The deps release MUST stay flagged as a prerelease: an ordinary release here
# becomes /releases/latest and breaks the README download link.
#
# r4 keeps LC_UUID. The first build here dropped it for reproducibility, and dyld
# on macOS 26.7 refuses to load an executable without one, so it aborts there;
# r4 gets reproducibility from ZERO_AR_DATE instead. Built with Xcode 27.
# 8.0.3-r4 is that r4 recipe pinned to FFmpeg 8.0.3, the third point release
# on the 8.0 branch.
#
# Superseded pins must NOT be deleted — each is what older tags verify against,
# and removing one makes those tags unbuildable from a clean checkout:
#   ffmpeg-deps-8.0-audio-arm64      this repo           v1.9.0 – v1.9.1
#   ffmpeg-deps-8.0-audio-arm64-r3   ClipHack-releases   v1.9.2
#   ffmpeg-deps-8.0-audio-arm64-r4   this repo           v1.9.3
# v1.9.2 borrowed ClipHack's r3 during the 2026-09-16 migration, before this repo
# had a build with LC_UUID of its own; r4 brings the pin home. The suffix follows
# the recipe revision shared with the sibling repos, so there is no r2 or r3 here.
FFMPEG_VERSION=8.0.3
FFMPEG_ARCH=arm64
FFMPEG_DEPS_REPO=sevmorris/FilmStrip
FFMPEG_DEPS_TAG=ffmpeg-deps-8.0.3-audio-arm64-r4
FFMPEG_SHA256=2e8f2e5052ae6557c91b40607f950daa3201dbbb33c408a8c9239689933adecf
FFPROBE_SHA256=094787df32084ed55ca5e55df4d56518c7a78a49297699cf1931e0e11dc68cf5

# Corresponding upstream source (LGPL §6) — see Vendor/README.md
FFMPEG_SOURCE_RELEASE=8.0.3
FFMPEG_SOURCE_RELEASE_DATE=2026-06-18
FFMPEG_SOURCE_ARCHIVE=ffmpeg-8.0.3.tar.xz
FFMPEG_SOURCE_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz
FFMPEG_SOURCE_SIGNATURE_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz.asc
FFMPEG_SOURCE_GIT_TAG=n8.0.3

# Statically linked LGPL dependency, built from source by scripts/build-ffmpeg.sh
LAME_VERSION=3.100
LAME_SOURCE_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz

# Superseded GPL build, bundled through app v1.8.3 and committed directly to git.
# It carried x264, x265, libvidstab, libaom, libsvtav1 and libvpx — every one a
# video encoder FilmStrip never invokes, since the app only ever encodes audio.
# Replaced rather than republished: distributing a GPL binary obliges us to
# supply its Corresponding Source, and this project has no build recipe for that
# one. Recorded here for provenance only; no script reads this value.
FFMPEG_SUPERSEDED_BUILD=gpl-x264-x265-vidstab-committed-to-git
